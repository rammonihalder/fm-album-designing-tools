{
  "manifestVersion": 5,
  "id": "9beaddeb",
  "name": "FM Album Designing Tools",
  "version": "1.4.0",
  "main": "index.html",
  "icons": [
    {
      "width": 24,
      "height": 24,
      "path": "assets/plugin-icons/plugin-icon.png",
      "scale": [
        1,
        2
      ],
      "theme": [
        "all"
      ],
      "species": [
        "pluginList"
      ]
    }
  ],
  "host": {
    "app": "PS",
    "minVersion": "23.3.0",
    "data": {
      "apiVersion": 2
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "memoryMakerAlbumPlacerPanel",
      "label": {
        "default": "FM Album Designing Tools"
      },
      "minimumSize": {
        "width": 240,
        "height": 220
      },
      "preferredDockedSize": {
        "width": 340,
        "height": 760
      },
      "preferredFloatingSize": {
        "width": 420,
        "height": 820
      },
      "maximumSize": {
        "width": 1200,
        "height": 1600
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "assets/panel-icons/panel-icon.png",
          "scale": [
            1,
            2
          ]
        }
      ]
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "network": {
      "domains": [
        "https://mm-license-server.rammonihalder.workers.dev"
      ]
    },
    "openURL": {
      "domains": [
        "https://wa.me"
      ]
    }
  }
}
