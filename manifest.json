{
  "manifestVersion": 5,
  "id": "in.memorymaker.albumplacer",
  "name": "MM Album Design Tools",
  "version": "1.0.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "23.3.0",
    "data": {
      "apiVersion": 2
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "memoryMakerAlbumPlacerPanel",
      "label": {
          "default": "MM Album Design Tools"
      },
      "minimumSize": {
        "width": 240,
        "height": 220
      },
      "preferredDockedSize": {
        "width": 340,
        "height": 760
      },
      "preferredFloatingSize": {
        "width": 420,
        "height": 820
      },
      "maximumSize": {
        "width": 1200,
        "height": 1600
      }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess"
  }
}
